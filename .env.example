# WorkOS application values must belong to UtilitySim, not GolfyGolf.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Explicit WorkOS user IDs. New users receive no permissions; emails must be verified.
UTILITYSIM_ROLE_GRANTS={}
# Optional persistent hosted runtime. Keep its bearer token server-side.
UTILITYSIM_RUNTIME_URL=
UTILITYSIM_RUNTIME_TOKEN=
