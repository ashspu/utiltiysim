                "minimum": 0,
                "maximum": 1,
                "x-effect": "Annual probability used for physical meter drift onset. Higher values increase drift risk. 0.01 means 1%.",
                "x-step": 0.001
              }
            }
          }
        }
      }
    },
    "defaults": {
      "world": {
